{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "database.rules.json",
      ".git/**",
      ".github/**",
      ".claude/**",
      "**/.*",
      "**/node_modules/**",
      "*.txt",
      "*.md",
      "*.ps1",
      "مصحف صوتي/**",
      "audio/**",
      "sound/**"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
